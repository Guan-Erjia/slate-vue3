{
  "include": ["./packages/**/*", "./test/**/*", "./playwright.config.ts"],
  "exclude": ["./docs/**/*"],
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "allowSyntheticDefaultImports": true,
    "composite": false,
    "declaration": true,
    "declarationMap": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "sourceMap": false,
    "strict": true,
    "target": "esnext",
    "emitDeclarationOnly": true,
    "verbatimModuleSyntax": false,
    "noCheck": false,
    "skipLibCheck": true,
    "paths": {
      "slate-vue3/core": ["./packages/slate"],
      "slate-vue3/dom": ["./packages/slate-dom"],
      "slate-vue3/history": ["./packages/slate-history"],
      "slate-vue3/hyperscript": ["./packages/slate-hyperscript"],
      "slate-vue3/yjs": ["./packages/slate-yjs"],
      "slate-vue3": ["./packages/slate-vue"],
      "share-tools": ["./packages/share-tools/index.ts"],
      "@test-utils": ["./test/utils.ts"],
    }
  }
}
