{
  "name": "slate-vue3",
  "version": "2.1.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "description": "slate-react library implemented with vue3",
  "license": "MIT",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/slate-vue/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./dom": {
      "import": {
        "types": "./dist/slate-dom/index.d.ts",
        "default": "./dist/dom.js"
      }
    },
    "./yjs": {
      "import": {
        "types": "./dist/slate-yjs/index.d.ts",
        "default": "./dist/yjs.js"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:lib": "vite build --mode=lib-watch",
    "build": "vite build",
    "preview": "vite preview",
    "build-all": "vite build --mode=lib",
    "e2e": "playwright test",
    "e2e-ui": "playwright test --ui",
    "test": "vitest",
    "release": "node ./scripts/release.mjs",
    "lint": "eslint  --max-warnings 0",
    "lint:fix": "eslint  --fix",
    "prepare": "husky",
    "typecheck": "vue-tsc --noEmit"
  },
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "direction": "^2.0.1",
    "is-hotkey": "^0.2.1",
    "lodash-es": "^4.18.1",
    "scroll-into-view-if-needed": "^3.1.0"
  },
  "peerDependencies": {
    "slate": "^0.147.4",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@liveblocks/client": "^3.25.0",
    "@liveblocks/yjs": "^3.25.0",
    "@playwright/test": "^1.65.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@testing-library/vue": "^8.1.0",
    "@types/is-hotkey": "^0.1.10",
    "@types/is-url": "^1.2.32",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "babel-plugin-transform-regex": "^6.1.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "image-extensions": "^1.1.0",
    "is-url": "^1.2.4",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prismjs": "^1.30.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-slate-transformer": "^0.9.0",
    "remark-stringify": "^11.0.0",
    "semantic-release": "^25.0.9",
    "slate": "^0.147.4",
    "slate-history": "^0.144.0",
    "slate-hyperscript": "^0.138.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "unified": "^11.0.5",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.6",
    "vite-plugin-babel": "^1.7.3",
    "vite-plugin-eslint2": "^5.3.0",
    "vitest": "^4.1.12",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14",
    "yjs": "^13.6.33"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guan-Erjia/slate-vue3.git"
  },
  "homepage": "https://guan-erjia.github.io/slate-vue3",
  "keywords": [
    "slate-vue3",
    "slate-vue",
    "slate",
    "editor",
    "contenteditable",
    "richtext",
    "rich",
    "editable",
    "markdown",
    "html"
  ]
}
